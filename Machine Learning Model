import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import mean_absolute_error, r2_score

def load_and_train():
    data = pd.read_csv("../dataset/food_delivery_data.csv")

    # Encode categorical data
    le_traffic = LabelEncoder()
    le_weather = LabelEncoder()

    data['traffic_level'] = le_traffic.fit_transform(data['traffic_level'])
    data['weather'] = le_weather.fit_transform(data['weather'])

    X = data[['distance_km', 'traffic_level', 'weather', 'prep_time']]
    y = data['actual_delivery_time']

    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

    model = LinearRegression()
    model.fit(X_train, y_train)

    predictions = model.predict(X_test)

    print("MAE:", mean_absolute_error(y_test, predictions))
    print("R2 Score:", r2_score(y_test, predictions))

    return model

if __name__ == "__main__":
    load_and_train()
