import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import mean_absolute_error, r2_score

def load_and_train():
    data = pd.read_csv("../dataset/train.csv")

    # Clean column names
    data.columns = data.columns.str.strip()

    # Handle missing values
    data = data.dropna()

    # Encode categorical columns
    le = LabelEncoder()
    data['Road_traffic_density'] = le.fit_transform(data['Road_traffic_density'])
    data['Weatherconditions'] = le.fit_transform(data['Weatherconditions'])

    # Select features
    X = data[['Delivery_person_Age', 'Delivery_person_Ratings',
              'Road_traffic_density', 'Weatherconditions']]

    y = data['Time_taken(min)']

    # Train test split
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

    model = LinearRegression()
    model.fit(X_train, y_train)

    predictions = model.predict(X_test)

    print("MAE:", mean_absolute_error(y_test, predictions))
    print("R2 Score:", r2_score(y_test, predictions))

    return model

if __name__ == "__main__":
    load_and_train()
